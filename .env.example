# Contoh environment variables untuk Vercel (Jangan commit nilai rahasia nyata)
# Isi nilai di Vercel Dashboard → Project → Settings → Environment Variables

# Mode/rilis
NEXT_PUBLIC_RELEASE_STAGE=production

# Analytics (Plausible/Umami) - kosongkan jika tidak pakai
NEXT_PUBLIC_ANALYTICS_PROVIDER=plausible
NEXT_PUBLIC_PLAUSIBLE_SITE=example.com

# Feature flags / eksperimen
NEXT_PUBLIC_DISABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_BETA=false

# PWA / Push (jika menggunakan Web Push/VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# API / backend (opsional — app ini client-only by spec, hanya contoh)
NEXT_PUBLIC_API_BASE_URL=

# Disclaimer: simpan variabel sensitif (secret keys) di Vercel sebagai "Environment Variable" tautan, jangan commit ke repo.
